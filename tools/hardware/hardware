__hardware__() {
    __hardware__.__help__() {
        echo """ABOUT:
    omni hardware manager

USAGE:
    hardware <module> <command> [args]

MODULES:
    mon     Monitor configuration
    wifi    Wireless network management

MON COMMANDS:
    ls                 List all monitors
    ls -e/--enabled    List only enabled monitors
    ls -d/--disabled   List only disabled monitors
    enable <mon>       Activate a monitor
    disable <mon>      Disable a monitor
    mv <mon> -l <ref>  Move monitor to the left of reference
    mv <mon> -r <ref>  Move monitor to the right of reference

WIFI COMMANDS:
    ls                         List available wifi connections
    ls -r/--registered         List registered wifi connections
    set/new <name> --id <id>   Register a wifi connection
    connect <name>             Connect to a registered wifi
    disconnect <name>          Disconnect a wifi connection
    rm <name>                  Remove a wifi connection""" >&2
    }

    __hardware__.mon.ls() {
        local show_enabled=0 show_disabled=0
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -e|--enabled) show_enabled=1 ;;
                -d|--disabled) show_disabled=1 ;;
            esac
            shift
        done
        
        local line mon is_enabled
        while read -r line; do
            if [[ "$line" == *" connected "* ]]; then
                mon="${line%% *}"
                is_enabled=0
                [[ "$line" == *" primary "* || "$line" =~ \ [0-9]+x[0-9]+\+ ]] && is_enabled=1
                
                if (( show_enabled )); then
                    (( is_enabled )) && echo "$mon"
                elif (( show_disabled )); then
                    (( ! is_enabled )) && echo "$mon"
                else
                    echo "$mon"
                fi
            fi
        done < <(xrandr)
    }

    __hardware__.mon.enable() {
        [[ -z "$1" ]] && return 1
        xrandr --output "$1" --auto
    }

    __hardware__.mon.disable() {
        [[ -z "$1" ]] && return 1
        xrandr --output "$1" --off
    }

    __hardware__.mon.mv() {
        local mon="$1" ref="" pos="" line
        shift
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -l|--left) pos="--left-of"; ref="$2"; shift ;;
                -r|--right) pos="--right-of"; ref="$2"; shift ;;
            esac
            shift
        done
        
        [[ -z "$mon" || -z "$pos" ]] && return 1
        
        if [[ -z "$ref" ]]; then
            while read -r line; do
                if [[ "$line" == *" connected primary "* ]]; then
                    ref="${line%% *}"
                    break
                fi
            done < <(xrandr)
        fi
        
        [[ -n "$ref" ]] && xrandr --output "$mon" --auto "$pos" "$ref"
    }

    __hardware__.mon() {
        local cmd="$1"
        shift
        case "$cmd" in
            ls) __hardware__.mon.ls "$@" ;;
            enable) __hardware__.mon.enable "$@" ;;
            disable) __hardware__.mon.disable "$@" ;;
            mv) __hardware__.mon.mv "$@" ;;
            *) echo "hardware mon: Unknown command '$cmd'" >&2; return 1 ;;
        esac
    }

    __hardware__.wifi.ls() {
        local show_registered=0
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -r|--registered) show_registered=1 ;;
            esac
            shift
        done

        if (( show_registered )); then
            local name uuid type
            while IFS=: read -r name uuid type _; do
                if [[ "$type" == "802-11-wireless" ]]; then
                    echo "$name"
                fi
            done < <(nmcli -t -f NAME,UUID,TYPE connection show)
        else
            nmcli --color=auto dev wifi list
        fi
    }

    __hardware__.wifi.set() {
        local name="" id="" pass=""
        if [[ "$1" != -* ]]; then
            name="$1"
            shift
        fi
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --id) id="$2"; shift ;;
                --pass) pass="$2"; shift ;;
                *) [[ -z "$name" ]] && name="$1" ;;
            esac
            shift
        done
        [[ -z "$name" || -z "$id" ]] && return 1
        
        nmcli connection add type wifi con-name "$name" ssid "$id" >/dev/null
        if [[ -n "$pass" ]]; then
            nmcli connection modify "$name" wifi-sec.key-mgmt wpa-psk wifi-sec.psk "$pass" >/dev/null
        fi
    }

    __hardware__.wifi.connect() {
        [[ -z "$1" ]] && return 1
        nmcli connection up "$1"
    }

    __hardware__.wifi.disconnect() {
        [[ -z "$1" ]] && return 1
        nmcli connection down "$1"
    }

    __hardware__.wifi.rm() {
        [[ -z "$1" ]] && return 1
        nmcli connection delete "$1"
    }

    __hardware__.wifi() {
        local cmd="$1"
        shift
        case "$cmd" in
            ls) __hardware__.wifi.ls "$@" ;;
            set|new) __hardware__.wifi.set "$@" ;;
            connect) __hardware__.wifi.connect "$@" ;;
            disconnect) __hardware__.wifi.disconnect "$@" ;;
            rm) __hardware__.wifi.rm "$@" ;;
            *) echo "hardware wifi: Unknown command '$cmd'" >&2; return 1 ;;
        esac
    }

    hardware() {
        local cmd="$1"
        if [[ -z "$cmd" || "$cmd" == "--help" || "$cmd" == "-h" ]]; then
            __hardware__.__help__
            return 0
        fi
        shift
        case "$cmd" in
            mon) __hardware__.mon "$@" ;;
            wifi) __hardware__.wifi "$@" ;;
            *) echo "hardware: Unknown command '$cmd'" >&2; return 1 ;;
        esac
    }

    __hardware__.__compl__() {
        local cur="${COMP_WORDS[COMP_CWORD]}" prev="${COMP_WORDS[COMP_CWORD-1]}" base_cmd="${COMP_WORDS[1]:-}" sub_cmd="${COMP_WORDS[2]:-}"
        
        if [[ "${COMP_CWORD}" == 1 ]]; then
            COMPREPLY=( $(compgen -W "mon wifi --help -h" -- "$cur") )
            return 0
        fi
        
        if [[ "$base_cmd" == "mon" ]]; then
            if [[ "${COMP_CWORD}" == 2 ]]; then
                COMPREPLY=( $(compgen -W "ls enable disable mv" -- "$cur") )
                return 0
            fi
            
            _get_mons() {
                local line mons=""
                while read -r line; do
                    [[ "$line" == *" connected "* ]] && mons+="${line%% *} "
                done < <(xrandr)
                echo "$mons"
            }

            if [[ "$sub_cmd" == "ls" && "$cur" == -* ]]; then
                COMPREPLY=( $(compgen -W "-e --enabled -d --disabled" -- "$cur") )
            elif [[ "$sub_cmd" == "enable" || "$sub_cmd" == "disable" ]]; then
                COMPREPLY=( $(compgen -W "$(_get_mons)" -- "$cur") )
            elif [[ "$sub_cmd" == "mv" ]]; then
                if [[ "${COMP_CWORD}" == 3 ]]; then
                    COMPREPLY=( $(compgen -W "$(_get_mons)" -- "$cur") )
                elif [[ "${COMP_CWORD}" == 4 && "$cur" == -* ]]; then
                    COMPREPLY=( $(compgen -W "-l --left -r --right" -- "$cur") )
                elif [[ "${COMP_CWORD}" == 5 && ("$prev" == "-l" || "$prev" == "--left" || "$prev" == "-r" || "$prev" == "--right") ]]; then
                    COMPREPLY=( $(compgen -W "$(_get_mons)" -- "$cur") )
                fi
            fi
        elif [[ "$base_cmd" == "wifi" ]]; then
            if [[ "${COMP_CWORD}" == 2 ]]; then
                COMPREPLY=( $(compgen -W "ls set new connect disconnect rm" -- "$cur") )
                return 0
            fi

            _get_wifi_registered() {
                local name uuid type
                while IFS=: read -r name uuid type _; do
                    [[ "$type" == "802-11-wireless" && -n "$name" ]] && echo "\"$name\""
                done < <(nmcli -t -f NAME,UUID,TYPE connection show)
            }

            if [[ "$sub_cmd" == "connect" || "$sub_cmd" == "disconnect" || "$sub_cmd" == "rm" ]]; then
                COMPREPLY=( $(compgen -W "$(_get_wifi_registered)" -- "$cur") )
            elif [[ "$sub_cmd" == "ls" && "$cur" == -* ]]; then
                COMPREPLY=( $(compgen -W "-r --registered" -- "$cur") )
            elif [[ "$sub_cmd" == "set" || "$sub_cmd" == "new" ]]; then
                if [[ "$cur" == -* ]]; then
                    COMPREPLY=( $(compgen -W "--id --pass" -- "$cur") )
                fi
            fi
        fi
    }

    __hardware__.__init__() {
        __compl hardware
    }
}
