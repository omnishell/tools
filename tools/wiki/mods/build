#! /bin/bash

__build__() {
   
    __build_init() {
        if [[ -z "${WIKI_PAGES[$w_name]:-}" ]]; then
            __log "WIKI_PAGES empty for '$w_name'. Building dynamically from '$SOURCEDIR'." -t info -l wiki
            while IFS= read -r -d '' file; do
                local rel_path="${file#$SOURCEDIR}"
                rel_path="${rel_path#/}"
                local no_ext="${rel_path%.*}"
                
                local prev_IFS="$IFS"
                IFS='/'
                local -a path_parts=($no_ext)
                IFS="$prev_IFS"
                
                local clean_slug=""
                local implicit_weight=""
                
                local i
                for ((i=0; i<${#path_parts[@]}; i++)); do
                    local part="${path_parts[$i]}"
                    local part_weight=""
                    
                    if [[ "$part" =~ ^([0-9]+)\.(.+)$ ]]; then
                        part_weight="${BASH_REMATCH[1]}"
                        part="${BASH_REMATCH[2]}"
                    elif [[ "$part" =~ ^([0-9]+)$ ]]; then
                        part_weight="${BASH_REMATCH[1]}"
                    fi
                    
                    if [[ -z "$clean_slug" ]]; then
                        clean_slug="$part"
                    else
                        clean_slug="${clean_slug}.${part}"
                    fi
                    
                    if (( i == ${#path_parts[@]} - 1 )); then
                        implicit_weight="$part_weight"
                    else
                        if [[ -n "$part_weight" && -z "${PAGE_WEIGHTS[$clean_slug]:-}" ]]; then
                            PAGE_WEIGHTS["$clean_slug"]="$part_weight"
                        fi
                    fi
                done
                
                _pages+=("$clean_slug")
                local var_str="path:${file}"
                [[ -n "$implicit_weight" ]] && var_str+=",implicit_weight:${implicit_weight}"
                WIKI_PAGE_VARS["${w_name}::${clean_slug}"]="$var_str"
            done < <(find "$SOURCEDIR" -type f -name "*.wiki" -print0)
        else
            local OIFS="$IFS"; IFS=','
            local p
            for p in ${WIKI_PAGES[$w_name]}; do _pages+=("$p"); done
            IFS="$OIFS"
        fi
        
        local p
        for p in "${_pages[@]}"; do
            local p_vars="${WIKI_PAGE_VARS[${w_name}::${p}]:-}"
            local file=""
            local implicit_weight=""
            local OIFS="$IFS"; IFS=','
            for pair in $p_vars; do
                local k="${pair%%:*}" v="${pair#*:}"
                [[ "$k" == "path" ]] && file="$v"
                [[ "$k" == "implicit_weight" ]] && implicit_weight="$v"
            done
            IFS="$OIFS"
            
            if [[ -z "$file" ]]; then
                file="${p_vars##*path:}"
                file="${file%%,*}"
            fi
            
            local rel_path="${file#$SOURCEDIR}"
            rel_path="${rel_path#/}"
            local no_ext="${rel_path%.*}"
            
            local prev_IFS="$IFS"
            IFS='/'
            local -a path_parts=($no_ext)
            IFS="$prev_IFS"
            
            local clean_slug=""
            local i
            for ((i=0; i<${#path_parts[@]}; i++)); do
                local part="${path_parts[$i]}"
                local part_weight=""
                
                if [[ "$part" =~ ^([0-9]+)\.(.+)$ ]]; then
                    part_weight="${BASH_REMATCH[1]}"
                    part="${BASH_REMATCH[2]}"
                elif [[ "$part" =~ ^([0-9]+)$ ]]; then
                    part_weight="${BASH_REMATCH[1]}"
                fi
                
                if [[ -z "$clean_slug" ]]; then
                    clean_slug="$part"
                else
                    clean_slug="${clean_slug}.${part}"
                fi
                
                if (( i < ${#path_parts[@]} - 1 )); then
                    if [[ -n "$part_weight" && -z "${PAGE_WEIGHTS[$clean_slug]:-}" ]]; then
                        PAGE_WEIGHTS["$clean_slug"]="$part_weight"
                    fi
                fi
            done
            
            local fm_title="" fm_weight=""
            
            if [[ -f "$file" ]]; then
                __fm_val_r "$file" "title" && fm_title="$REPLY"
                __fm_val_r "$file" "weight" && [[ -n "$REPLY" ]] && fm_weight="$REPLY"
                
                local in_globals=0 g_line
                while IFS= read -r g_line || [[ -n "$g_line" ]]; do
                    g_line="${g_line%$'\r'}"
                    if (( in_globals == 0 )); then
                        [[ "$g_line" =~ ^[[:space:]]*\{\{[[:space:]]*block\.globals[[:space:]]*\}\}[[:space:]]*$ ]] && in_globals=1
                    else
                        [[ "$g_line" =~ ^[[:space:]]*\{\{[[:space:]]*block\.end[[:space:]]*\}\}[[:space:]]*$ ]] && break
                        if [[ "$g_line" =~ ^[[:space:]]*::[[:space:]]*title:[[:space:]]*(.*)$ ]]; then
                            local temp_title="${BASH_REMATCH[1]}"
                            temp_title="${temp_title#"${temp_title%%[![:space:]]*}"}"
                            temp_title="${temp_title%"${temp_title##*[![:space:]]}"}"
                            [[ -n "$temp_title" ]] && fm_title="$temp_title"
                        elif [[ "$g_line" =~ ^[[:space:]]*::[[:space:]]*(weight|weighted):[[:space:]]*(.*)$ ]]; then
                            local temp_weight="${BASH_REMATCH[2]}"
                            temp_weight="${temp_weight#"${temp_weight%%[![:space:]]*}"}"
                            temp_weight="${temp_weight%"${temp_weight##*[![:space:]]}"}"
                            [[ -n "$temp_weight" ]] && fm_weight="$temp_weight"
                        fi
                    fi
                done < "$file"
            fi
            
            if [[ -z "$fm_weight" && -n "$implicit_weight" ]]; then
                fm_weight="$implicit_weight"
            elif [[ -z "$fm_weight" ]]; then
                local fname="${file##*/}"
                if [[ "$fname" =~ ^([0-9]+)\.(.+)\.wiki$ ]]; then
                    fm_weight="${BASH_REMATCH[1]}"
                elif [[ "$fname" =~ ^([0-9]+)\.wiki$ ]]; then
                    fm_weight="${BASH_REMATCH[1]}"
                else
                    fm_weight="9999999"
                fi
            elif [[ "$fm_weight" == -* || -n "${fm_weight//[0-9]/}" ]]; then
                fm_weight="9999999"
            fi
            
            PAGE_TITLES["$p"]="$fm_title"
            if [[ -z "${PAGE_WEIGHTS[$p]:-}" || "$fm_weight" != "9999999" ]]; then
                PAGE_WEIGHTS["$p"]="$fm_weight"
            fi
            
            local -a parts=()
            local OIFS="$IFS"; IFS='.'; read -ra parts <<< "$p"; IFS="$OIFS"
            if [ "${#parts[@]}" -ge 2 ]; then _nested_pages+=("$p")
            else _global_pages+=("${parts[0]}"); fi
        done
    }

    __build_assets() {
        mkdir -p "$BUILDDIR/_assets"
        
        if [[ -d "$ASSETSDIR" ]]; then
            local s_nullglob=0
            shopt -q nullglob && s_nullglob=1 || shopt -s nullglob

            local cwebp_bin=""
            if [[ -f "$_WIKI_DIR/bin/cwep" ]]; then
                cwebp_bin="$_WIKI_DIR/bin/cwep"
                [[ -x "$cwebp_bin" ]] || chmod +x "$cwebp_bin" 2>/dev/null
            elif [[ -f "$_WIKI_DIR/bin/cwebp" ]]; then
                cwebp_bin="$_WIKI_DIR/bin/cwebp"
                [[ -x "$cwebp_bin" ]] || chmod +x "$cwebp_bin" 2>/dev/null
            elif command -v cwebp >/dev/null 2>&1; then
                cwebp_bin="cwebp"
            fi

            _process_dir() {
                local dir="${1%/}"
                local img base
                for img in "$dir"/*; do
                    if [[ -d "$img" ]]; then
                        _process_dir "$img"
                    elif [[ -f "$img" ]]; then
                        case "$img" in
                            *.[pP][nN][gG] | *.[jJ][pP][gG] | *.[jJ][pP][eE][gG])
                                base="${img%.*}"
                                if [[ ! -f "${base}.webp" ]]; then
                                    __log "Obtaining webp for: $img" -t info -l wiki
                                    if [[ -n "$cwebp_bin" ]]; then
                                        __log "using cwep..."
                                        "$cwebp_bin" -q 80 "$img" -o "${base}.webp"
                                    elif command -v convert >/dev/null 2>&1; then
                                        __log "using convert..."
                                        convert "$img" -quality 80 "${base}.webp" >/dev/null 2>&1
                                    else
                                        __error "aaaaaaaa"
                                    fi
                                fi
                                ;;
                        esac
                    fi
                done
            }

            _process_dir "$ASSETSDIR"

            cp -r "${ASSETSDIR%/}"/* "$BUILDDIR/_assets/" 2>/dev/null || true

            (( s_nullglob == 0 )) && shopt -u nullglob
        fi
    } 



    __build_cache() {
        mkdir -p "$cache_dir" 2>/dev/null
        # The tool itself is hashed too, so a change to how pages render reaches unchanged pages
        local tmpl_hash="" hash_dirs=("$_WIKI_DIR/wiki" "$_WIKI_DIR/mods" "$_WIKI_DIR/bin")
        [[ -d "$TEMPLATEDIR" ]] && hash_dirs+=("$TEMPLATEDIR")
        tmpl_hash=$(find "${hash_dirs[@]}" -type f -exec cksum {} + | LC_ALL=C sort -k3 | cksum | awk '{print $1 "_" $2}')
        local old_tmpl_hash=""
        [[ -f "$tmpl_cache_file" ]] && old_tmpl_hash=$(<"$tmpl_cache_file")
        if [[ "$tmpl_hash" != "$old_tmpl_hash" ]]; then
            force_rebuild=1
            printf "%s\n" "$tmpl_hash" > "$tmpl_cache_file"
            > "$cache_file"
        fi
        if [[ -z "$p_name" && $force_rebuild -eq 1 ]]; then
            __log "Cleaning and preparing environment for '$w_name'..." -t info -l wiki
            find "$BUILDDIR" -mindepth 1 -maxdepth 1 ! -name "${cache_dir##*/}" -exec rm -rf {} + 2>/dev/null || true
        fi
        
        mkdir -p "$BUILDDIR/_static"
        if [[ -d "$STATICDIR" ]]; then
            cp -r "$STATICDIR"/* "$BUILDDIR/_static/" 2>/dev/null || true
        fi
        
        if [[ -f "$cache_file" ]]; then
            while IFS=' ' read -r h f; do
                [[ -n "$f" ]] && CACHE_HASHES["$f"]="$h"
            done < "$cache_file"
        fi
    }


    __build_partials() {
        __partial_featured
        __partial_menu
        
        for p in "${_pages[@]}"; do
            local map_p_name="${p##*.}" map_p_dir="" map_p_url=""
            local disp_name="${PAGE_TITLES[$p]:-}"
            [[ -z "$disp_name" ]] && disp_name="$map_p_name"
            if [[ "$p" == *.* ]]; then
                local p_dir_raw="${p%.*}"
                map_p_dir="${p_dir_raw//./\/}"; map_p_url="${map_p_dir}/${map_p_name}.html"
            else
                map_p_dir="."; map_p_url="${map_p_name}.html"
            fi
            DIR_FILES_MAP["$map_p_dir"]+="<li><a href=\"/${map_p_url}\">${disp_name}</a></li>"$'\n'
        done
    }

    # Rendered and skipped pages both merge here, so the first page in build order sets a block's title key.
    __build_title_key() {
        [[ -n "$2" && -z "${BLOCK_TITLE_KEYS[$1]:-}" ]] && BLOCK_TITLE_KEYS["$1"]="$2"
        return 0
    }

    __build_main() {
        if [[ -n "$p_name" ]]; then build_targets=("$p_name")
        else build_targets=("${_pages[@]}"); fi
        
        # First line of each cached index file. Entries start with '{', so it cannot clash.
        local title_key_header="title_key="
        # One cksum for all pages instead of one fork per page
        local -A file_hashes=()
        local -a hash_files=()
        for p in "${build_targets[@]}"; do
            local p_vars="${WIKI_PAGE_VARS[${w_name}::${p}]:-}"
            local file=""
            local OIFS="$IFS"; IFS=','
            for pair in $p_vars; do
                local k="${pair%%:*}" v="${pair#*:}"
                [[ "$k" == "path" ]] && file="$v"
            done
            IFS="$OIFS"
            # cksum does not escape newlines in names; those fall back to a per-file cksum
            [[ -f "$file" && "$file" != *$'\n'* ]] && hash_files+=("$file")
        done
        if (( ${#hash_files[@]} > 0 )); then
            local h_crc h_size h_file
            while IFS=' ' read -r h_crc h_size h_file; do
                file_hashes["$h_file"]="${h_crc}_${h_size}"
            done < <(cksum -- "${hash_files[@]}")
        fi
        
        for p in "${build_targets[@]}"; do
            local p_vars="${WIKI_PAGE_VARS[${w_name}::${p}]:-}"
            local file="" p_tmpl=""
            local OIFS="$IFS"; IFS=','
            for pair in $p_vars; do
                local k="${pair%%:*}" v="${pair#*:}"
                case "$k" in
                    path) file="$v" ;;
                    template) p_tmpl="$v" ;;
                esac
            done
            IFS="$OIFS"
            if [[ ! -f "$file" ]]; then continue; fi
            
            local current_dir="${p%.*}"
            if [[ "$current_dir" == "$p" ]]; then current_dir="."; fi
            
            local in_globals=0 g_line
            while IFS= read -r g_line || [[ -n "$g_line" ]]; do
                g_line="${g_line%$'\r'}"
                if (( in_globals == 0 )); then
                    [[ "$g_line" =~ ^[[:space:]]*\{\{[[:space:]]*block\.globals[[:space:]]*\}\}[[:space:]]*$ ]] && in_globals=1
                else
                    [[ "$g_line" =~ ^[[:space:]]*\{\{[[:space:]]*block\.end[[:space:]]*\}\}[[:space:]]*$ ]] && break
                    if [[ "$g_line" =~ ^[[:space:]]*::[[:space:]]*template:[[:space:]]*(.*)$ ]]; then
                        local temp_tmpl="${BASH_REMATCH[1]}"
                        temp_tmpl="${temp_tmpl#"${temp_tmpl%%[![:space:]]*}"}"
                        temp_tmpl="${temp_tmpl%"${temp_tmpl##*[![:space:]]}"}"
                        [[ "$temp_tmpl" != *.* ]] && temp_tmpl="${temp_tmpl}.html"
                        [[ -n "$temp_tmpl" ]] && p_tmpl="${TEMPLATEDIR}/${temp_tmpl}"
                    fi
                fi
            done < "$file"
            
            if [[ -z "$p_tmpl" ]]; then
                local idx_slug="${current_dir}.index"
                [[ "$current_dir" == "." ]] && idx_slug="index"
                
                if [[ "$p" != "$idx_slug" ]]; then
                    local idx_vars="${WIKI_PAGE_VARS[${w_name}::${idx_slug}]:-}"
                    if [[ -n "$idx_vars" ]]; then
                        local idx_file=""
                        local OIFS="$IFS"; IFS=','
                        for pair in $idx_vars; do
                            local k="${pair%%:*}" v="${pair#*:}"
                            [[ "$k" == "path" ]] && idx_file="$v"
                        done
                        IFS="$OIFS"
                        
                        if [[ -f "$idx_file" ]]; then
                            local in_globals_idx=0 g_line_idx
                            while IFS= read -r g_line_idx || [[ -n "$g_line_idx" ]]; do
                                g_line_idx="${g_line_idx%$'\r'}"
                                if (( in_globals_idx == 0 )); then
                                    [[ "$g_line_idx" =~ ^[[:space:]]*\{\{[[:space:]]*block\.globals[[:space:]]*\}\}[[:space:]]*$ ]] && in_globals_idx=1
                                else
                                    [[ "$g_line_idx" =~ ^[[:space:]]*\{\{[[:space:]]*block\.end[[:space:]]*\}\}[[:space:]]*$ ]] && break
                                    if [[ "$g_line_idx" =~ ^[[:space:]]*::[[:space:]]*template:[[:space:]]*(.*)$ ]]; then
                                        local temp_tmpl="${BASH_REMATCH[1]}"
                                        temp_tmpl="${temp_tmpl#"${temp_tmpl%%[![:space:]]*}"}"
                                        temp_tmpl="${temp_tmpl%"${temp_tmpl##*[![:space:]]}"}"
                                        [[ "$temp_tmpl" != *.* ]] && temp_tmpl="${temp_tmpl}.html"
                                        [[ -n "$temp_tmpl" ]] && p_tmpl="${TEMPLATEDIR}/${temp_tmpl}"
                                    fi
                                fi
                            done < "$idx_file"
                        fi
                    fi
                fi
            fi
            local page_tmpl_raw="${p_tmpl:-$TEMPLATEDIR}"
            if [[ -n "${WIKI_TEMPLATE_VARS[$page_tmpl_raw]:-}" ]]; then
                page_tmpl_raw="${WIKI_TEMPLATE_VARS[$page_tmpl_raw]}"
            elif [[ -d "$page_tmpl_raw" ]]; then
                page_tmpl_raw="${page_tmpl_raw}/layout.html"
            fi
            
            if [[ ! -f "$page_tmpl_raw" ]]; then
                __log "Template file missing for page $p at $page_tmpl_raw" -t error -l wiki
                continue
            fi
            local pagename="$p"
            local out_path="$BUILDDIR/${p//./\/}.html"
            local file_hash="${file_hashes[$file]:-}"
            if [[ -z "$file_hash" ]]; then
                file_hash=$(cksum < "$file")
                file_hash="${file_hash/ /_}"
            fi
            if [[ $force_rebuild -eq 0 && -n "$file_hash" && "${CACHE_HASHES[$file]:-}" == "$file_hash" && -f "$out_path" ]]; then
                # Every rendered page caches a page entry, so an index without the header predates it: render instead.
                local -a replay_names=() replay_keys=() replay_chunks=()
                local replay_ok=1
                for idx_f in "$cache_dir/$pagename"_index_*.json; do
                    [[ -f "$idx_f" ]] || continue
                    local bname="${idx_f##*_index_}"
                    bname="${bname%.json}"
                    local chunk=""
                    IFS= read -r -d '' chunk < "$idx_f" || true
                    if [[ "$chunk" != "$title_key_header"* ]]; then replay_ok=0; break; fi
                    local header="${chunk%%$'\n'*}"
                    replay_names+=("$bname")
                    replay_keys+=("${header#"$title_key_header"}")
                    replay_chunks+=("${chunk#*$'\n'}")
                done
                if (( replay_ok )); then
                    local ri
                    for ri in "${!replay_names[@]}"; do
                        bname="${replay_names[$ri]}"
                        SEARCH_INDEX_MAP["$bname"]+="${replay_chunks[$ri]}"
                        __build_title_key "$bname" "${replay_keys[$ri]}"
                    done
                    __log "Skipped rendering $pagename (unmodified)" -t info -l wiki
                    continue
                fi
            fi
            mkdir -p "${out_path%/*}"
            
            local RAW_LAYOUT
            read -r -d '' RAW_LAYOUT < "$page_tmpl_raw" || true
            local -a layout_lines
            mapfile -t layout_lines <<< "$RAW_LAYOUT"
            
            local -A old_len_map=()
            for k in "${!SEARCH_INDEX_MAP[@]}"; do old_len_map["$k"]="${#SEARCH_INDEX_MAP[$k]}"; done
            
            PAGE_TITLE_KEYS=()
            __render_main "$file" "$pagename" "$out_path" "$current_dir"

            local -A idx_written=()
            for k in "${!SEARCH_INDEX_MAP[@]}"; do
                local old_len="${old_len_map[$k]:-0}"
                local new_content="${SEARCH_INDEX_MAP[$k]:$old_len}"
                if [[ -n "$new_content" ]]; then
                    local idx_path="$cache_dir/${pagename}_index_${k}.json"
                    printf "%s%s\n%s" "$title_key_header" "${PAGE_TITLE_KEYS[$k]:-}" "$new_content" > "$idx_path"
                    idx_written["$idx_path"]=1
                    __build_title_key "$k" "${PAGE_TITLE_KEYS[$k]:-}"
                fi
            done
            # Block types the page no longer emits would be replayed on the next skip.
            # Names with a second _index_ may belong to another page, so they are kept.
            local -a idx_stale=()
            for idx_f in "$cache_dir/$pagename"_index_*.json; do
                [[ -f "$idx_f" && -z "${idx_written[$idx_f]:-}" ]] || continue
                [[ "${idx_f#"$cache_dir/$pagename"_index_}" == *_index_* ]] && continue
                idx_stale+=("$idx_f")
            done
            (( ${#idx_stale[@]} )) && rm -f -- "${idx_stale[@]}"
            CACHE_HASHES["$file"]="$file_hash"
        done
        local search_js="const SEARCH_CONFIG = ["
        local sf=1
        for k in "${!SEARCH_INDEX_MAP[@]}"; do
            (( sf == 0 )) && search_js+=","
            local fallback="${k^}"
            local tkey="${BLOCK_TITLE_KEYS[$k]:-$k}"
            [[ "$k" == "page" ]] && tkey="pagename"
            [[ "$k" == "table" ]] && tkey="caption"
            [[ "$k" == "tag" ]] && tkey="pagename"
            search_js+=" { id: '$k', others: ['${k}s'], titleKey: '$tkey', fallback: '$fallback' }"
            sf=0
        done
        search_js+=" ];"
        local search_marker="const SEARCH_CONFIG = ["
        for p in "${build_targets[@]}"; do
            local out_path="$BUILDDIR/${p//./\/}.html"
            if [[ -f "$out_path" ]]; then
                local html_content
                html_content="$(<"$out_path")"
                # Last marker: the injected script follows any quoted in the page body.
                local pre="${html_content%"$search_marker"*}"
                if [[ "$html_content" == *"%%WIKI_SEARCH_CONFIG%%"* ]]; then
                    html_content="${html_content//%%WIKI_SEARCH_CONFIG%%/$search_js}"
                    printf "%s" "$html_content" > "$out_path"
                elif (( ${#pre} < ${#html_content} )); then
                    # Slice after pre: a leading-* glob trim is quadratic on large pages.
                    local post="${html_content:${#pre}+${#search_marker}}"
                    post="${post#*\];}"
                    html_content="${pre}${search_js}${post}"
                    printf "%s" "$html_content" > "$out_path"
                fi
            fi
        done
    }

    __build_search_index() {
        > "$cache_file"
        for f in "${!CACHE_HASHES[@]}"; do
            echo "${CACHE_HASHES[$f]} $f" >> "$cache_file"
        done
        __save
        
        local json_content="{"
        local first=1
        for k in "${!SEARCH_INDEX_MAP[@]}"; do
            local arr_str="${SEARCH_INDEX_MAP[$k]}"
            arr_str="${arr_str%$'\n'}"
            arr_str="${arr_str%,}"
            (( first == 0 )) && json_content+=","
            json_content+="\"$k\": [ $arr_str ]"
            first=0
        done
        json_content+="}"
        printf "%s" "$json_content" > "$BUILDDIR/index.json"
    }

    __build_defs_index() {
        local json_content="{"
        local first=1
        
        local defs_data="${SEARCH_INDEX_MAP["def"]:-}"
        local line
        while IFS= read -r line || [[ -n "$line" ]]; do
            line="${line%"${line##*[![:space:]]}"}"
            [[ -z "$line" ]] && continue
            
            local context="" term="" id="" related="" url=""
            
            if [[ "$line" =~ \"url\":\"([^\"]*)\" ]]; then
                url="${BASH_REMATCH[1]}"
            fi
            if [[ "$line" =~ \"__context__\":\"([^\"]*)\" ]]; then
                context="${BASH_REMATCH[1]}"
            fi
            if [[ "$line" =~ \"term\":\"([^\"]*)\" ]]; then
                term="${BASH_REMATCH[1]}"
            fi
            if [[ "$line" =~ \"__id__\":\"([^\"]*)\" ]]; then
                id="${BASH_REMATCH[1]}"
            fi
            if [[ "$line" =~ \"related\":\"([^\"]*)\" ]]; then
                related="${BASH_REMATCH[1]}"
            fi
            
            local raw_id="$id"
            [[ -z "$raw_id" ]] && raw_id="$term"
            [[ -z "$raw_id" ]] && continue
            
            __slugify_r "$raw_id"
            local clean_id="$REPLY"
            local ref_key="$clean_id"
            if [[ -n "$context" && "$raw_id" != *.* ]]; then
                __slugify_r "${context}.${raw_id}"
                ref_key="$REPLY"
            fi
            
            local -a rel_arr=()
            if [[ -n "$related" ]]; then
                local old_ifs="$IFS"
                IFS=","
                local items=($related)
                IFS="$old_ifs"
                local r
                for r in "${items[@]}"; do
                    r="${r#"${r%%[![:space:]]*}"}"
                    r="${r%"${r##*[![:space:]]}"}"
                    r="${r#def.}"
                    if [[ -n "$r" ]]; then
                        __slugify_r "$r"
                        r="$REPLY"
                        rel_arr+=("\"$r\"")
                    fi
                done
            fi
            
            local rel_json=""
            if [[ ${#rel_arr[@]} -gt 0 ]]; then
                local old_ifs="$IFS"
                IFS=","
                rel_json="${rel_arr[*]}"
                IFS="$old_ifs"
            fi
            
            (( first == 0 )) && json_content+=","
            json_content+=$'\n'"  \"${ref_key}\": { \"url\": \"${url}\", \"deps\": [ ${rel_json} ] }"
            first=0
            
        done <<< "$defs_data"
        
        json_content+=$'\n'"}"
        
        printf "%s\n" "$json_content" > "$BUILDDIR/defs.json"
        __log "Generated defs index -> $BUILDDIR/defs.json" -t success -l wiki
    }

    __build_sitemap() {
        local domain=""
        
        if [[ "${WIKI_VARS[$w_name]:-}" =~ (domain|url):[[:space:]]*([^,]+) ]]; then
            domain="${BASH_REMATCH[2]}"
        fi
        
        if [[ -z "$domain" ]]; then
            __log "No domain was found. Skipping sitemap.xml generation." -t warning -l wiki
            return 1
        fi
        
        domain="${domain%/}"
        [[ "$domain" != http://* && "$domain" != https://* ]] && domain="https://$domain"
        
        local current_date
        printf -v current_date "%(%Y-%m-%d)T" -1
        
        local xml_content="<?xml version=\"1.0\" encoding=\"UTF-8\"?>"$'\n'
        xml_content+="<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">"$'\n'
        
        # Last commit date of each source keeps lastmod stable across builds and clones.
        # Read once for the whole tree.
        # Git paths are repo-root relative, so page paths are mapped the same way.
        local -A commit_dates=() dirty=()
        local line date="" git_top="" git_shallow="" src_key=""
        { read -r git_top; read -r git_shallow; } < <(git -C "$SOURCEDIR" rev-parse --show-toplevel --is-shallow-repository 2>/dev/null)
        if [[ "$git_shallow" == "true" ]]; then
            __log "Shallow git clone: sitemap lastmod uses the build date." -t warning -l wiki
        elif [[ -n "$git_top" ]] && src_key="$(cd "$SOURCEDIR" 2>/dev/null && pwd -P)" && [[ "$src_key" == "$git_top" || "$src_key" == "$git_top"/* ]]; then
            src_key="${src_key#"$git_top"}"
            src_key="${src_key#/}"
            while IFS= read -r line; do
                [[ -n "$line" ]] && dirty["$line"]=1
            done < <(git -C "$git_top" -c core.quotepath=off diff --name-only HEAD -- "${src_key:-.}" 2>/dev/null)
            # Log is newest first, so the first date seen for a file is its latest.
            while IFS= read -r line; do
                if [[ "$line" == ">"* ]]; then date="${line#>}"
                elif [[ -n "$line" && -z "${commit_dates[$line]:-}" ]]; then commit_dates["$line"]="$date"
                fi
            done < <(git -C "$git_top" -c core.quotepath=off log --format='>%cd' --date=short --name-only -- "${src_key:-.}" 2>/dev/null)
        fi
        
        local p path loc file lastmod p_vars
        for p in "${_pages[@]}"; do
            path="${p//./\/}.html"
            loc="${domain}/${path}"
            [[ "$path" == "index.html" ]] && loc="${domain}/"
            
            file=""
            p_vars="${WIKI_PAGE_VARS[${w_name}::${p}]:-}"
            [[ "$p_vars" =~ (^|,)path:([^,]+) ]] && file="${BASH_REMATCH[2]}"
            # Sources live under SOURCEDIR. Rebase them onto its repo-root relative path.
            if [[ -n "$file" && "$file" == "$SOURCEDIR"/* ]]; then
                file="${file#"$SOURCEDIR"/}"
                [[ -n "$src_key" ]] && file="$src_key/$file"
            else
                file=""
            fi
            
            # Uncommitted, untracked or non-git sources are being changed now, so use today.
            lastmod="$current_date"
            if [[ -n "$file" && -z "${dirty[$file]:-}" && -n "${commit_dates[$file]:-}" ]]; then
                lastmod="${commit_dates[$file]}"
            fi
            
            xml_content+="  <url>"$'\n'
            xml_content+="    <loc>${loc}</loc>"$'\n'
            xml_content+="    <lastmod>${lastmod}</lastmod>"$'\n'
            xml_content+="  </url>"$'\n'
        done
        xml_content+="</urlset>"$'\n'
        
        printf "%s" "$xml_content" > "$BUILDDIR/sitemap.xml"
        __log "Generated sitemap -> $BUILDDIR/sitemap.xml" -t success -l wiki
    }

}
