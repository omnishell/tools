        [[ -n "$title" ]] && out+="<h1>${title}</h1>"$'\n'
        out+="$(__listing_pages "$args")"
        printf "%s" "$out"
    }
        
    __partial_head() {
        local h_title="" h_css="" h_js="" h_thumb=""
        local str="$*"
        while [[ "$str" =~ ([a-zA-Z_.-]+)=([^\"\'[:space:]]+|\"([^\"]+)\"|\'([^\']+)\') ]]; do
